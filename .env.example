# Bot API message sending and Mini App authentication; set in private .env
APP_ENV=development
TELEGRAM_BOT_TOKEN=
# Owner's positive numeric private chat ID; also prefills personal test sends
CHAT_ID=

# Telegram MTProto credentials (not required by the Mini App)
API_ID=
API_HASH=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional deployment settings; no credentials belong in source files
# HOST=127.0.0.1
PORT=8000
TELEGRAM_API_BASE_URL=https://api.telegram.org
SEND_INTERVAL_SECONDS=1.2
# May be lowered; valid range 1-20, shared by backend validation and frontend
DIRECT_SEND_MAX_RECIPIENTS=20
# Initial workspace defaults; editable in Connection and then persisted in SQLite
DEFAULT_CURRENCY=INR
DEFAULT_LANGUAGE=English
DEFAULT_TONE=friendly
